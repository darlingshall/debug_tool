  "commands": [
    {
      "title": "查看网络相关进程",
      "cmd": "ps aux | grep -E \"connman|dhcp|net\" | grep -v grep"
    },
    {
      "title": "查看路由表",
      "cmd": "/sbin/route"
    },
    {
      "title": "查看系统运行时间",
      "cmd": "uptime"
    },
    {
      "title": "查看磁盘空间",
      "cmd": "df"
    },
    {
      "title": "查看日志目录文件列表",
      "cmd": "ls -alh /var/log/"
    }
  ]
}